{
  "name": "@pfm/rulebook-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc && cp -r src/generated dist/",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts --ignore-pattern 'src/generated/**'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pfm/shared-db": "*",
    "@pfm/shared-http": "*",
    "@pfm/shared-config": "*",
    "@prisma/client": "^5.8.0",
    "prisma": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  }
}